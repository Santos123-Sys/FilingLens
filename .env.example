# ── AI provider ─────────────────────────────────────────────────
# Keep this value server-side only. Do not expose it in browser code.
OPENAI_API_KEY=

# ── Server-to-server public regulatory finance integration ─────
# Use a random value of at least 32 characters. Keep it server-side only.
# GPI and Portfolio Risk receive the same value through their own secret stores.
FILINGLENS_READ_API_TOKEN=

# Railway/MySQL connection used by historical and public regulatory stores.
DATABASE_URL=

# ── Yahoo Finance research data (unofficial yfinance; personal use ONLY) ──
# No FMP API key or paid market-data subscription required.
# Turn on for a PRIVATE single-researcher application after checking Yahoo's terms.
YAHOO_PERSONAL_USE_ENABLED=false
# Long private bearer token (>=32 chars). Used on the Railway web service ONLY.
# Existing FilingLens valuation read token can be reused. Enter only via dashboard field.
FILINGLENS_VALUATION_READ_API_TOKEN=
# Daily Railway cron watchlist, max 12 symbols. No holdings are sent to Yahoo.
FILINGLENS_MONITOR_SYMBOLS=AAPL
